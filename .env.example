# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — with both keys, OpenAI parses searches and Claude is the fallback (AI_PRIMARY=anthropic flips it).
# Admin search reviews use AI_REVIEW_MODEL on Claude. Embeddings need the OpenAI key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
AI_PRIMARY=openai
AI_CLAUDE_MODEL=claude-sonnet-5-5
AI_REVIEW_MODEL=claude-opus-5-5
AI_OPENAI_MODEL=gpt-6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_MS=8000

# Cloudinary (photos)
# Place photos: Cloudinary is the main store, Supabase Storage the fallback when these are empty.
# Runtime only (no rebuild). CLOUDINARY_URL=cloudinary://key:secret@cloud also works instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
