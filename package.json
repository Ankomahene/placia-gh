{
  "name": "placia",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@placia/web",
    "dev:admin": "turbo run dev --filter=@placia/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:types": "pnpm --filter @placia/db gen:types",
    "db:push": "supabase db push",
    "ai:smoke": "pnpm --filter @placia/core ai:smoke",
    "ingest": "pnpm --filter @placia/ingest ingest",
    "eval": "pnpm --filter @placia/evals eval"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "supabase": "3.1.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "supabase",
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@duckdb/node-bindings"
    ]
  }
}
